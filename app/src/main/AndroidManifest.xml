<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">

    <!-- 电话 -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />

    <!-- 语音采集 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- 首次下载模型包 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 技能执行 -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- 常驻监听 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- ★ 悬浮窗服务声明了 foregroundServiceType="specialUse"，Android 14(API 34) 起必须
         同时声明对应的前台服务类型权限，否则 startForeground() 抛 SecurityException
         （悬浮球起不来）。API 29 车机上该权限未知，声明后被系统忽略，无副作用。 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 开机自启 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- 悬浮窗 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- 存储权限说明：
         1. 日志、录音、配置默认保存在 getExternalFilesDir() 应用私有目录，不需要存储权限
         2. 但车机（鼎微/全志方案，Android 10）访问 U 盘根目录需要存储权限，否则 Permission denied
         3. Android 10：requestLegacyExternalStorage="true" + READ/WRITE_EXTERNAL_STORAGE 权限
         4. Android 11+：需要 MANAGE_EXTERNAL_STORAGE 权限（用户手动在设置页开启"所有文件访问"）
         5. 车机是 Android 10，所以主要靠 READ/WRITE_EXTERNAL_STORAGE + requestLegacyExternalStorage -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <!-- Android 11+ 所有文件访问权限（用于U盘读写） -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!-- ★ 包可见性（Android 11 / API 30 起强制）：不声明则 getPackageInfo /
         getLaunchIntentForPackage / queryIntentActivities / getInstalledApplications
         只能看到自己和已声明可见的包，导航与播放器探测会全部误判"未安装"。
         刻意不申请 QUERY_ALL_PACKAGES（受限权限，上架会被拒审）。 -->
    <queries>
        <!-- 导航 App（对应 core/nav/*Launcher.kt 的 packageName） -->
        <package android:name="com.autonavi.amapauto" />
        <package android:name="com.baidu.BaiduMap" />
        <package android:name="com.autonavi.minimap" />
        <package android:name="com.tencent.map" />
        <package android:name="com.baidu.naviauto" />
        <package android:name="com.tencent.wecarnavi" />

        <!-- 音乐播放器（对应 MusicPlayerManager.musicPlayerPackages 优先级列表，共 12 个） -->
        <package android:name="fun.upup.musicfree" />
        <package android:name="com.tw.music" />
        <package android:name="com.netease.cloudmusic.iot" />
        <package android:name="com.tencent.qqmusiccar" />
        <package android:name="com.kugou.android.auto" />
        <package android:name="cn.kuwo.kwmusiccar" />
        <package android:name="cn.kuwo.autolite" />
        <package android:name="com.netease.cloudmusic" />
        <package android:name="com.luna.music" />
        <package android:name="com.tencent.qqmusic" />
        <package android:name="com.kugou.android" />
        <package android:name="cn.kuwo.player" />

        <!-- 打开应用技能（AppLaunchSkill 用 getInstalledApplications 做名称模糊匹配）：
             声明"可启动应用"查询，使所有带启动图标的常规 App 可见。 -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>

        <!-- TTS：Android 11+ 下不声明 TTS_SERVICE 查询，TextToSpeech 会找不到任何引擎 -->
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>

        <!-- 导出 U 盘：MainActivity 用 ACTION_OPEN_DOCUMENT_TREE 探测 DocumentsUI 可用性 -->
        <intent>
            <action android:name="android.intent.action.OPEN_DOCUMENT_TREE" />
        </intent>
    </queries>

    <application
        android:name=".VoiceAssistantApp"
        android:allowBackup="true"
        android:extractNativeLibs="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:requestLegacyExternalStorage="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.CarVoiceAssistant">

        <!-- 百度语音 SDK 鉴权信息：不内置任何 Key -->
        <!-- 用户必须在设置页填写自己的 App ID/API Key/Secret Key -->
        <!-- AipeEventManagerFactory 会动态传入用户填的 Key，不需要 meta-data -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".PlaceManagerActivity"
            android:exported="false"
            android:label="同音字词库"
            android:windowSoftInputMode="stateVisible|adjustResize" />

        <activity
            android:name=".LogViewerActivity"
            android:exported="false"
            android:label="日志查看" />

        <!-- 常驻语音服务：API 34+ 需要 microphone 前台服务类型 -->
        <service
            android:name=".core.VoiceAssistantService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- 悬浮窗服务：前台服务，避免后台启动被系统拦截 -->
        <service
            android:name=".core.FloatViewService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="floating window for voice assistant" />
        </service>

        <!-- 开机自启接收器：只保留系统允许静态注册的广播
             ACC_ON、DO_WAKEUP 等隐式广播在 Android 8+ 静态注册收不到，
             全部放到 VoiceAssistantService 里动态注册 -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true"
            android:enabled="true">
            <intent-filter android:priority="1000">
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.USER_PRESENT" />
                <action android:name="android.intent.action.ACTION_SHUTDOWN" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
