<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">

    <!-- 电话 -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />

    <!-- 语音采集 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- 首次下载模型包 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 技能执行 -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- 常驻监听 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 开机自启 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- 悬浮窗 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- 存储权限说明：
         1. 日志、录音、配置默认保存在 getExternalFilesDir() 应用私有目录，不需要存储权限
         2. 但车机（鼎微/全志方案，Android 10）访问 U 盘根目录需要存储权限，否则 Permission denied
         3. Android 10：requestLegacyExternalStorage="true" + READ/WRITE_EXTERNAL_STORAGE 权限
         4. Android 11+：需要 MANAGE_EXTERNAL_STORAGE 权限（用户手动在设置页开启"所有文件访问"）
         5. 车机是 Android 10，所以主要靠 READ/WRITE_EXTERNAL_STORAGE + requestLegacyExternalStorage -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <!-- Android 11+ 所有文件访问权限（用于U盘读写） -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <application
        android:name=".VoiceAssistantApp"
        android:allowBackup="true"
        android:extractNativeLibs="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:requestLegacyExternalStorage="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.CarVoiceAssistant">

        <!-- 百度语音 SDK 鉴权信息：不内置任何 Key -->
        <!-- 用户必须在设置页填写自己的 App ID/API Key/Secret Key -->
        <!-- AipeEventManagerFactory 会动态传入用户填的 Key，不需要 meta-data -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".CalibrationActivity"
            android:exported="false"
            android:label="唤醒灵敏度校准" />

        <activity
            android:name=".PlaceManagerActivity"
            android:exported="false"
            android:label="同音字词库"
            android:windowSoftInputMode="stateVisible|adjustResize" />

        <activity
            android:name=".LogViewerActivity"
            android:exported="false"
            android:label="日志查看" />

        <!-- 常驻语音服务：API 34+ 需要 microphone 前台服务类型 -->
        <service
            android:name=".core.VoiceAssistantService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- 悬浮窗服务：前台服务，避免后台启动被系统拦截 -->
        <service
            android:name=".core.FloatViewService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="floating window for voice assistant" />
        </service>

        <!-- 开机自启接收器（针对鼎微/全志车机优化） -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true"
            android:enabled="true">
            <intent-filter android:priority="1000">
                <!-- 标准开机广播 -->
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.REBOOT" />
                <action android:name="android.intent.action.USER_PRESENT" />
                <!-- 快速开机广播（部分厂商使用） -->
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
                <!-- 车机系统特有广播（鼎微/全志/MTK等车机方案） -->
                <action android:name="android.intent.action.ACTION_BOOT_COMPLETED" />
                <action android:name="com.android.systemui.BOOT_COMPLETED" />
                <action android:name="android.intent.action.BOOT_COMPLETED_FINISHED" />
                <!-- ★ 鼎微/全志车机特有广播（从固件解包发现） -->
                <action android:name="com.unisound.intent.action.ACC_ON" />
                <action android:name="com.unisound.intent.action.DO_WAKEUP" />
                <action android:name="com.unisound.intent.action.DO_SHOW" />
                <!-- ★ 屏幕亮/唤醒相关（点火唤醒最常用） -->
                <action android:name="android.intent.action.SCREEN_ON" />
                <action android:name="android.intent.action.SCREEN_OFF" />
                <action android:name="android.intent.action.USER_PRESENT" />
                <action android:name="android.intent.action.CLOSE_SYSTEM_DIALOGS" />
                <!-- ★ 开机阶段相关 -->
                <action android:name="android.intent.action.PRE_BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.ACTION_SHUTDOWN" />
                <!-- ★ 电源/点火相关 -->
                <action android:name="android.intent.action.ACTION_POWER_CONNECTED" />
                <action android:name="android.intent.action.POWER_CONNECTED" />
                <action android:name="android.intent.action.ACTION_POWER_DISCONNECTED" />
                <action android:name="android.intent.action.POWER_DISCONNECTED" />
                <action android:name="android.intent.action.BATTERY_CHANGED" />
                <action android:name="android.intent.action.CHARGING" />
                <action android:name="android.intent.action.DISCHARGING" />
                <action android:name="android.os.action.POWER_SAVE_MODE_CHANGED" />
                <!-- ★ 车机模式相关 -->
                <action android:name="android.app.action.ENTER_CAR_MODE" />
                <action android:name="android.app.action.EXIT_CAR_MODE" />
                <!-- ★ USB/U盘相关 -->
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
                <action android:name="android.hardware.usb.action.USB_DEVICE_DETACHED" />
                <action android:name="android.hardware.usb.action.USB_ACCESSORY_ATTACHED" />
                <!-- 注意：Android 8.0+ 大部分隐式广播被禁止静态注册接收
                     （CONNECTIVITY_CHANGE、MEDIA_MOUNTED、HEADSET_PLUG 等都收不到）
                     服务被杀后的兜底由 AutoStartWorker（WorkManager，每15分钟检查）负责 -->
            </intent-filter>
        </receiver>

    </application>
</manifest>
