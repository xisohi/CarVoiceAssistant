<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="3dp">
        <!-- ============ 标题栏 ============ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="3dp">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#1A1B1C" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="纯离线运行 · 仅首次安装联网"
                    android:textSize="9sp"
                    android:textColor="#6B7280" />
            </LinearLayout>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBackground"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:text="后台运行"
                android:textSize="10sp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingHorizontal="8dp"
                android:paddingVertical="0dp"
                android:enabled="false" />
        </LinearLayout>
        <!-- ============ 服务状态 + 权限 + 模型 三列 ============ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="2dp">
            <!-- ① 服务状态 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="2dp"
                app:cardCornerRadius="5dp"
                app:contentPadding="3dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="服务状态"
                        android:textSize="9sp"
                        android:textColor="#6B7280" />
                    <TextView
                        android:id="@+id/tvServiceState"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="○ 已停止"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:layout_marginTop="1dp" />
                    <TextView
                        android:id="@+id/tvVoiceState"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textSize="8sp"
                        android:textColor="#6B7280"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:layout_marginTop="1dp" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnToggleService"
                        android:layout_width="match_parent"
                        android:layout_height="24dp"
                        android:text="启动服务"
                        android:textSize="9sp"
                        android:layout_marginTop="3dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingVertical="0dp" />
                    <Space
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <!-- ② 权限设置 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="2dp"
                app:cardCornerRadius="5dp"
                app:contentPadding="3dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="权限设置"
                        android:textSize="9sp"
                        android:textColor="#6B7280" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="2dp"
                        android:gravity="center_vertical">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="悬浮窗"
                            android:textSize="10sp" />
                        <TextView
                            android:id="@+id/tvOverlayState"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="检测中…"
                            android:textSize="9sp"
                            android:textColor="#6B7280" />
                    </LinearLayout>
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#E4E3DD"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="2dp" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="开机自启"
                            android:textSize="10sp" />
                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/switchAutoStart"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true" />
                    </LinearLayout>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnOpenAutoStartSettings"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="24dp"
                        android:text="系统自启设置"
                        android:textSize="9sp"
                        android:layout_marginTop="3dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingVertical="0dp" />
                    <Space
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <!-- ③ 离线模型 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                app:cardCornerRadius="5dp"
                app:contentPadding="3dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="离线模型"
                        android:textSize="9sp"
                        android:textColor="#6B7280" />
                    <TextView
                        android:id="@+id/tvModelState"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="检测中…"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:layout_marginTop="1dp"
                        android:maxLines="1"
                        android:ellipsize="end" />
                    <ProgressBar
                        android:id="@+id/progressDownload"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="3dp"
                        android:layout_marginTop="3dp" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDownload"
                        android:layout_width="match_parent"
                        android:layout_height="24dp"
                        android:text="下载语音包"
                        android:textSize="9sp"
                        android:layout_marginTop="3dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingVertical="0dp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="约50-100MB"
                        android:textSize="8sp"
                        android:textColor="#6B7280"
                        android:layout_marginTop="1dp" />
                    <Space
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
        <!-- ============ 状态明细条（从服务卡搬出） ============ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="3dp"
            android:paddingHorizontal="3dp">
            <TextView
                android:id="@+id/tvLastIntent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="9sp"
                android:textColor="#6B7280"
                android:maxLines="1"
                android:ellipsize="end" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="1dp">
                <TextView
                    android:id="@+id/tvRms"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="录音RMS: --"
                    android:textSize="9sp"
                    android:textColor="#9E9E9E"
                    android:maxLines="1"
                    android:layout_marginEnd="6dp" />
                <TextView
                    android:id="@+id/tvTtsState"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="TTS：检测中..."
                    android:textSize="9sp"
                    android:textColor="#6B7280"
                    android:maxLines="1"
                    android:ellipsize="end" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTtsSettings"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="22dp"
                    android:text="TTS设置"
                    android:textSize="9sp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingHorizontal="4dp"
                    android:paddingVertical="0dp" />
            </LinearLayout>
        </LinearLayout>
        <!-- ============ 唤醒灵敏度卡 ============ -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="3dp"
            app:cardCornerRadius="5dp"
            app:contentPadding="3dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="唤醒灵敏度"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/tvSensitivityDesc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="中（增益4.5x，阈值0.008）"
                        android:textSize="9sp"
                        android:textColor="#1A73E8" />
                </LinearLayout>
                <!-- 低/中/高 三档按钮 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="3dp">
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSensLow"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="26dp"
                        android:layout_weight="1"
                        android:text="低"
                        android:textSize="10sp"
                        android:layout_marginEnd="2dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingVertical="0dp" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSensMedium"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="26dp"
                        android:layout_weight="1"
                        android:text="中"
                        android:textSize="10sp"
                        android:layout_marginEnd="2dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingVertical="0dp" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSensHigh"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="26dp"
                        android:layout_weight="1"
                        android:text="高"
                        android:textSize="10sp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingVertical="0dp" />
                </LinearLayout>
                <!-- 检测阈值：标签 + 滑块 + 值 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="4dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="阈值"
                        android:textSize="9sp"
                        android:layout_marginEnd="3dp" />
                    <SeekBar
                        android:id="@+id/seekThreshold"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:max="99"
                        android:progress="7"
                        android:minHeight="18dp" />
                    <TextView
                        android:id="@+id/tvThresholdValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0.008"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:textColor="#1A73E8"
                        android:layout_marginStart="3dp" />
                </LinearLayout>
                <!-- 音频增益 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="1dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="增益"
                        android:textSize="9sp"
                        android:layout_marginEnd="3dp" />
                    <SeekBar
                        android:id="@+id/seekGain"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:max="70"
                        android:progress="35"
                        android:minHeight="18dp" />
                    <TextView
                        android:id="@+id/tvGainValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="4.5x"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:textColor="#1A73E8"
                        android:layout_marginStart="3dp" />
                </LinearLayout>
                <!-- 识别增益 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="1dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="识别"
                        android:textSize="9sp"
                        android:layout_marginEnd="3dp" />
                    <SeekBar
                        android:id="@+id/seekAsrGain"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:max="50"
                        android:progress="30"
                        android:minHeight="18dp" />
                    <TextView
                        android:id="@+id/tvAsrGainValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="8.0x"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:textColor="#1A73E8"
                        android:layout_marginStart="3dp" />
                </LinearLayout>
                <!-- 5 个按钮一行 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="2dp">
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCalibration"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="22dp"
                        android:layout_weight="1"
                        android:text="校准"
                        android:textSize="8sp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingVertical="0dp" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnApplyManual"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="22dp"
                        android:layout_weight="1"
                        android:text="应用"
                        android:textSize="8sp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingVertical="0dp" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnResetManual"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="22dp"
                        android:layout_weight="1"
                        android:text="恢复"
                        android:textSize="8sp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingVertical="0dp" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPlaceManager"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="22dp"
                        android:layout_weight="1"
                        android:text="词库"
                        android:textSize="8sp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingVertical="0dp" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnLogViewer"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="22dp"
                        android:layout_weight="1"
                        android:text="日志"
                        android:textSize="8sp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingVertical="0dp" />
                </LinearLayout>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✅ 参数立即生效，无需重启"
                    android:textSize="8sp"
                    android:textColor="#2E7D32"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <!-- ============ 百度语音识别配置卡 ============ -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardBaiduConfig"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="3dp"
            app:cardCornerRadius="5dp"
            app:contentPadding="3dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="百度语音识别（在线，识别率更高）"
                    android:textSize="9sp"
                    android:textColor="#6B7280" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="请使用您自己的百度账号在百度智能云创建应用并获取以下参数（个人认证免费15万次）"
                    android:textSize="8sp"
                    android:textColor="#FF9800"
                    android:layout_marginTop="1dp" />
                <TextView
                    android:id="@+id/tvBaiduGuide"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="获取方式：百度智能云 → 语音技术 → 创建应用 | ⚠️ 语音包名必须填：com.xisohi.car.voiceassistant"
                    android:textSize="8sp"
                    android:textColor="#9E9E9E"
                    android:autoLink="none"
                    android:maxLines="2"
                    android:ellipsize="end" />
                <!-- App ID 整行 -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:hint="App ID（9位数字）"
                    app:boxBackgroundMode="outline"
                    app:boxStrokeWidth="1dp"
                    app:boxStrokeWidthFocused="1dp">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etBaiduAppId"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:textSize="10sp"
                        android:paddingVertical="3dp" />
                </com.google.android.material.textfield.TextInputLayout>
                <!-- API Key + Secret Key 两列 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="1dp">
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="2dp"
                        android:hint="API Key（24位）"
                        app:boxBackgroundMode="outline"
                        app:boxStrokeWidth="1dp"
                        app:boxStrokeWidthFocused="1dp"
                        app:endIconMode="password_toggle">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etBaiduApiKey"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPassword"
                            android:textSize="10sp"
                            android:paddingVertical="3dp" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="Secret（32位）"
                        app:boxBackgroundMode="outline"
                        app:boxStrokeWidth="1dp"
                        app:boxStrokeWidthFocused="1dp"
                        app:endIconMode="password_toggle">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etBaiduSecretKey"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPassword"
                            android:textSize="10sp"
                            android:paddingVertical="3dp" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
                <!-- 保存 + 测试 + 导入 三列 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="2dp">
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSaveBaiduConfig"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="24dp"
                        android:layout_weight="1"
                        android:text="保存配置"
                        android:textSize="9sp"
                        android:layout_marginEnd="2dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingVertical="0dp" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTestBaiduConfig"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="24dp"
                        android:layout_weight="1"
                        android:text="测试连接"
                        android:textSize="9sp"
                        android:layout_marginEnd="2dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingVertical="0dp" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnImportBaiduConfig"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
