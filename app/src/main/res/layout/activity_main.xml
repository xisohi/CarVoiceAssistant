<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="6dp">

        <!-- 标题栏 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#1A1B1C" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="纯离线运行 · 仅首次安装联网"
                    android:textSize="10sp"
                    android:textColor="#6B7280" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBackground"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="后台运行"
                android:textSize="11sp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingHorizontal="10dp"
                android:paddingVertical="0dp"
                android:enabled="false" />
        </LinearLayout>

        <!-- 服务状态卡 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            app:cardCornerRadius="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvServiceState"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="○ 已停止"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvVoiceState"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="—"
                            android:textSize="10sp"
                            android:textColor="#6B7280" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnToggleService"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:text="启动服务"
                        android:textSize="11sp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="0dp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="最近识别"
                    android:textSize="9sp"
                    android:textColor="#6B7280"
                    android:layout_marginTop="3dp" />

                <TextView
                    android:id="@+id/tvLastRecognized"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:textSize="11sp"
                    android:textColor="#1A1B1C"
                    android:background="#F4F5F7"
                    android:padding="3dp"
                    android:maxLines="2"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/tvLastIntent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="10sp"
                    android:textColor="#6B7280"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="2dp">

                    <TextView
                        android:id="@+id/tvTtsState"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="TTS：检测中..."
                        android:textSize="10sp"
                        android:textColor="#6B7280"
                        android:maxLines="1"
                        android:ellipsize="end" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="唤醒：小娜"
                        android:textSize="9sp"
                        android:textColor="#6B7280"
                        android:layout_marginEnd="4dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTtsSettings"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:text="TTS设置"
                        android:textSize="10sp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingHorizontal="4dp"
                        android:paddingVertical="0dp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 权限 + 模型 两列布局 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="4dp">

            <!-- 权限设置卡 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="2dp"
                app:cardCornerRadius="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="权限设置"
                        android:textSize="10sp"
                        android:textColor="#6B7280" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="3dp"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="悬浮窗"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tvOverlayState"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="检测中…"
                            android:textSize="11sp"
                            android:textColor="#6B7280" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#E4E3DD"
                        android:layout_marginTop="3dp"
                        android:layout_marginBottom="3dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="开机自启"
                            android:textSize="12sp" />

                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/switchAutoStart"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnOpenAutoStartSettings"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="30dp"
                        android:text="系统自启设置"
                        android:textSize="10sp"
                        android:layout_marginTop="4dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingVertical="0dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 离线模型卡 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="2dp"
                app:cardCornerRadius="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="离线模型"
                        android:textSize="10sp"
                        android:textColor="#6B7280" />

                    <TextView
                        android:id="@+id/tvModelState"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="检测中…"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:layout_marginTop="2dp" />

                    <ProgressBar
                        android:id="@+id/progressDownload"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="4dp"
                        android:layout_marginTop="4dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDownload"
                        android:layout_width="match_parent"
                        android:layout_height="30dp"
                        android:text="下载语音包"
                        android:textSize="11sp"
                        android:layout_marginTop="4dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingVertical="0dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="约50-100MB"
                        android:textSize="9sp"
                        android:textColor="#6B7280"
                        android:layout_marginTop="2dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- 唤醒灵敏度卡 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            app:cardCornerRadius="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="唤醒灵敏度"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvSensitivityDesc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="中（增益4.5x，阈值0.008）"
                        android:textSize="10sp"
                        android:textColor="#1A73E8" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="4dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSensLow"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="30dp"
                        android:layout_weight="1"
                        android:text="低"
                        android:textSize="11sp"
                        android:layout_marginEnd="2dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingVertical="0dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSensMedium"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="30dp"
                        android:layout_weight="1"
                        android:text="中"
                        android:textSize="11sp"
                        android:layout_marginEnd="2dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingVertical="0dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSensHigh"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="30dp"
                        android:layout_weight="1"
                        android:text="高"
                        android:textSize="11sp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingVertical="0dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="2dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCalibration"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="0dp"
                        android:layout_height="28dp"
                        android:layout_weight="1"
                        android:text="自动校准"
                        android:textSize="11sp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingVertical="0dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPlaceManager"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="0dp"
                        android:layout_height="28dp"
                        android:layout_weight="1"
                        android:text="同音字词库"
                        android:textSize="11sp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingVertical="0dp" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E4E3DD"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="3dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="手动调节"
                    android:textSize="10sp"
                    android:textColor="#6B7280"
                    android:textStyle="bold" />

                <!-- threshold 滑块 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="2dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="检测阈值 threshold"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvThresholdValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0.008"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#1A73E8" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/seekThreshold"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="99"
                    android:progress="7"
                    android:minHeight="24dp" />

                <!-- gain 滑块 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="2dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="音频增益 gain"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvGainValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="4.5x"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#1A73E8" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/seekGain"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="45"
                    android:progress="35"
                    android:minHeight="24dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="4dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnApplyManual"
                        android:layout_width="0dp"
                        android:layout_height="30dp"
                        android:layout_weight="1"
                        android:text="应用参数"
                        android:textSize="11sp"
                        android:layout_marginEnd="3dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingVertical="0dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnResetManual"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="30dp"
                        android:layout_weight="1"
                        android:text="恢复默认"
                        android:textSize="11sp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingVertical="0dp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✅ 参数立即生效，无需重启"
                    android:textSize="9sp"
                    android:textColor="#2E7D32"
                    android:layout_marginTop="3dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 日志卡 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="运行日志"
                    android:textSize="10sp"
                    android:textColor="#6B7280" />

                <ScrollView
                    android:id="@+id/scrollLog"
                    android:layout_width="match_parent"
                    android:layout_height="90dp"
                    android:layout_marginTop="3dp"
                    android:background="#F4F5F7"
                    android:padding="4dp">

                    <TextView
                        android:id="@+id/tvLog"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="10sp"
                        android:typeface="monospace"
                        android:textColor="#1A1B1C" />
                </ScrollView>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>